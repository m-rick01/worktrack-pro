# Copy this file to .env and fill in real values before running in production.

# Port the Node process listens on (your host's Node.js App setup usually assigns this for you).
PORT=3000

# If the app is mounted under a subpath of your domain (e.g. https://orthoclic.ca/time),
# set BASE_PATH to that path. Leave empty if the app is served at the domain root or a subdomain.
BASE_PATH=/time

# Full public URL of the app, used in emails (invite links, etc.).
APP_URL=https://orthoclic.ca/time

# SQLite database file location (defaults to ./data/worktrack.db if unset).
DB_PATH=./data/worktrack.db

# SMTP settings for outgoing email (new-account credentials, approval/rejection notices).
# Use your PlanetHoster mailbox for the domain, e.g. timesheet@orthoclic.ca.
SMTP_HOST=mail.orthoclic.ca
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=timesheet@orthoclic.ca
SMTP_PASS=your-mailbox-password
SMTP_FROM=timesheet@orthoclic.ca

# Used only by `npm run seed` to create the first admin account.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@orthoclic.ca
ADMIN_PASSWORD=ChangeMe123!

# Local testing: print emails to the console instead of sending them.
# Must be false (or absent) in production.
MAIL_DRY_RUN=false
